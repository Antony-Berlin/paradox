# ---- PARADOX environment template ----
# Copy to .env and fill in locally. NEVER commit a real key.
#
#   cp .env.example .env
#
# Get a free Gemini API key at https://aistudio.google.com/apikey

# Gemini API key for Google ADK (API-key mode, not Vertex).
GOOGLE_API_KEY=

# Use Gemini Developer API (key mode) rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model id for all LLM-backed ADK agents (configurable).
# Default is the stable "flash latest" alias; dated ids like gemini-2.5-flash
# may be unavailable to newer keys. Any generateContent-capable Gemini works.
PARADOX_MODEL=gemini-flash-latest

# Optional: override the SQLite DB path (default: paradox_state.db in CWD).
# PARADOX_DB=paradox_state.db
